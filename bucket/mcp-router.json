{
    "version": "0.6.2",
    "description": "统一管理 Model Context Protocol (MCP) 服务器的桌面应用。",
    "homepage": "https://github.com/mcp-router/mcp-router",
    "license": {
        "identifier": "Proprietary",
        "url": "https://github.com/mcp-router/mcp-router/blob/main/LICENSE.md"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/mcp-router/mcp-router/releases/download/v0.6.2/MCP.Router-win32-x64-0.6.2.zip",
            "hash": "71121b15c1cb89b782695415bf98d88441188a313bc8c66c296fadeae3d5b0c1"
        }
    },
    "shortcuts": [
        [
            "MCP Router.exe",
            "MCP Router"
        ]
    ],
    "notes": "运行时数据在 %AppData%\\MCP Router，安装时链接到 persist/roaming（Electron 本地存储，见 post_install）。",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mcp-router/mcp-router/releases/download/v$version/MCP.Router-win32-x64-$version.zip",
                "hash": {
                    "mode": "download"
                }
            }
        }
    },
    "post_install": [
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "$mcpRouterPortableMappings = @(@{ Label = 'roaming'; Source = 'AppData/MCP Router'; Target = \"$persist_dir/roaming\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' })",
        "Invoke-PortableMappings -Action Install -Context @{ Dir = $dir; PersistDir = $persist_dir } -Mappings $mcpRouterPortableMappings -Log:$true"
    ],
    "pre_uninstall": [
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "$mcpRouterPortableMappings = @(@{ Label = 'roaming'; Source = 'AppData/MCP Router'; Target = \"$persist_dir/roaming\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' })",
        "Invoke-PortableMappings -Action Uninstall -Context @{ Dir = $dir; PersistDir = $persist_dir } -Mappings $mcpRouterPortableMappings -Log:$true"
    ]
}
