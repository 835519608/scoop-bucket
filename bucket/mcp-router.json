{
    "version": "0.6.2",
    "description": "统一管理 Model Context Protocol (MCP) 服务器的桌面应用。",
    "homepage": "https://github.com/mcp-router/mcp-router",
    "license": {
        "identifier": "Proprietary",
        "url": "https://github.com/mcp-router/mcp-router/blob/main/LICENSE.md"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/mcp-router/mcp-router/releases/download/v0.6.2/MCP.Router-win32-x64-0.6.2.zip",
            "hash": "71121b15c1cb89b782695415bf98d88441188a313bc8c66c296fadeae3d5b0c1"
        }
    },
    "bin": [
        ["MCP Router.exe", "mcp-router"]
    ],
    "shortcuts": [
        ["MCP Router.exe", "MCP Router"]
    ],
    "notes": "数据目录联接到 persist/roaming。安装后注册进程监听：MCP Router 启动约 3 秒后自动关闭开机启动（无需 VBS/CMD 启动器）。直接运行 exe 或开始菜单均可。",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mcp-router/mcp-router/releases/download/v$version/MCP.Router-win32-x64-$version.zip",
                "hash": {
                    "mode": "download"
                }
            }
        }
    },
    "post_install": [
        ". (Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\utils.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName",
        "Install-PersistDataLinks -Mappings (Get-McpRouterPersistMappings -EnsureTarget) -Log:$true",
        "try { Install-McpRouterAutostartWatcher; Disable-McpRouterLogonStartup } catch { Write-Warning \"MCP Router autostart watcher failed: $_\"; Disable-McpRouterLogonStartup }",
        "Remove-McpRouterLaunchArtifacts"
    ],
    "pre_uninstall": [
        ". (Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\utils.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName",
        "Remove-McpRouterAutostartWatcher",
        "Remove-McpRouterLegacyScheduledTask",
        "Remove-McpRouterLaunchArtifacts",
        "Disable-McpRouterLogonStartup",
        "Uninstall-PersistDataLinks -Mappings (Get-McpRouterPersistMappings) -Log:$true"
    ]
}
