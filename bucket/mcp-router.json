{
    "version": "0.6.2",
    "description": "统一管理 Model Context Protocol (MCP) 服务器的桌面应用。",
    "homepage": "https://github.com/mcp-router/mcp-router",
    "license": {
        "identifier": "Proprietary",
        "url": "https://github.com/mcp-router/mcp-router/blob/main/LICENSE.md"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/mcp-router/mcp-router/releases/download/v0.6.2/MCP.Router-win32-x64-0.6.2.zip",
            "hash": "71121b15c1cb89b782695415bf98d88441188a313bc8c66c296fadeae3d5b0c1"
        }
    },
    "bin": [
        ["MCP Router.exe", "mcp-router"]
    ],
    "shortcuts": [
        ["MCP Router.exe", "MCP Router"]
    ],
    "notes": "须在管理员 PowerShell 中 scoop install。已装但无 WMI 监听时，在管理员下执行 scoop reset mcp-router。",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mcp-router/mcp-router/releases/download/v$version/MCP.Router-win32-x64-$version.zip",
                "hash": {
                    "mode": "download"
                }
            }
        }
    },
    "pre_install": [
        ". (Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\import-utils.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName",
        "Assert-AdminElevation -OnFailure SkipInstall -Reason 'WMI 进程监听（启动后自动关闭开机启动）' -InstallHint 'scoop install scoop-bucket/mcp-router'"
    ],
    "post_install": [
        ". (Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\import-utils.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName",
        "$mcpMappings = @(@{ Label = 'roaming'; Source = 'AppData/MCP Router'; Target = '$persist_dir/roaming'; EnsureTarget = $true })",
        "Install-PersistDataLinks -Mappings $mcpMappings -Log:$true",
        "Install-AppProcessAutostartBlocker -ProcessName 'MCP Router.exe' -WatcherFilterName 'Scoop_McpRouter_ProcessStart' -WatcherConsumerName 'Scoop_McpRouter_DisableAutostart' -LogonStartupCommandFilter @('*MCP Router*', '*mcp-router*') -LogonStartupNameFilter @('*MCP Router*', '*mcp-router*') -LegacyScheduledTaskName 'scoop-mcp-router-no-autostart' -RemoveLaunchArtifactNames @('mcp-router.vbs', 'mcp-router.cmd', 'mcp-router-launch.ps1') -SuccessMessage 'mcp-router: 已注册进程监听，应用启动后将自动关闭开机启动。'"
    ],
    "pre_uninstall": [
        ". (Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\import-utils.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName",
        "Uninstall-AppProcessAutostartBlocker -WatcherFilterName 'Scoop_McpRouter_ProcessStart' -WatcherConsumerName 'Scoop_McpRouter_DisableAutostart' -LogonStartupCommandFilter @('*MCP Router*', '*mcp-router*') -LogonStartupNameFilter @('*MCP Router*', '*mcp-router*') -LegacyScheduledTaskName 'scoop-mcp-router-no-autostart' -RemoveLaunchArtifactNames @('mcp-router.vbs', 'mcp-router.cmd', 'mcp-router-launch.ps1')",
        "Uninstall-PersistDataLinks -Mappings @(@{ Label = 'roaming'; Source = 'AppData/MCP Router'; Target = '$persist_dir/roaming' }) -Log:$true"
    ]
}
