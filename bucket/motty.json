{
    "version": "0.3.6",
    "description": "原生 SSH 工作台：终端、SFTP、端口转发、VNC/RDP 与 AI 助手同窗（Go + Viva，无 WebView）",
    "homepage": "https://github.com/t8y2/motty",
    "license": "Apache-2.0",
    "notes": [
        "便携 zip：数据在程序旁 motty-data（主机、设置、known_hosts、密码库），由 Scoop persist 持久化。",
        "密码库密钥为 motty-data\\vault.key；能拷走该目录即可读出已保存密码。",
        "便携版不会自我更新，请用 scoop update motty。",
        "v0.3.2+ 已修复 Scoop current 联接导致无法启动的问题。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.3.6/motty-0.3.6-windows-amd64.zip",
            "hash": "8b178106c80e85279b3c7acb7e682ad42b57cc910121eedd00dcc1cde9790fe7"
        },
        "arm64": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.3.6/motty-0.3.6-windows-arm64.zip",
            "hash": "78f160153ee97b9afa6a7de7d7ce85d62ca9f007251a6da36b8d8bce74b5405a"
        }
    },
    "bin": "motty.exe",
    "shortcuts": [
        [
            "motty.exe",
            "Motty"
        ]
    ],
    "persist": "motty-data",
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/motty/post_install.ps1'",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-amd64.zip",
                "hash": {
                    "url": "https://github.com/t8y2/motty/releases/download/v$version/SHA256SUMS",
                    "find": "motty-$version-windows-amd64\\.zip"
                }
            },
            "arm64": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-arm64.zip",
                "hash": {
                    "url": "https://github.com/t8y2/motty/releases/download/v$version/SHA256SUMS",
                    "find": "motty-$version-windows-arm64\\.zip"
                }
            }
        }
    }
}
