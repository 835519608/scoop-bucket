{
    "version": "0.3.1",
    "description": "原生 SSH 工作台：终端、SFTP、端口转发、VNC/RDP 与 AI 助手同窗（Go + Viva，无 WebView）",
    "homepage": "https://github.com/t8y2/motty",
    "license": "Apache-2.0",
    "notes": [
        "官方便携 zip 会在 exe 旁带 motty-data；在 Scoop 的 current 联接下会触发单实例路径错误。",
        "安装后删除旁路 motty-data，改用 %APPDATA%\\motty（联接到 persist/roaming），开始菜单与 AltRun 均可直接启动。",
        "请重启已打开的 AltRun，再 scoop update / scoop reset motty。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.3.1/motty-0.3.1-windows-amd64.zip",
            "hash": "946e1f6aacbd58d9256f8e838524731756ea3c81e73c8bf49d85c35ba7a44945"
        },
        "arm64": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.3.1/motty-0.3.1-windows-arm64.zip",
            "hash": "578dd5daa00ba222d41e54215b6770bf99dcd5d2e1cd1be862697271d0377070"
        }
    },
    "bin": "motty.exe",
    "shortcuts": [
        [
            "motty.exe",
            "Motty"
        ]
    ],
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/motty/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/motty/pre_uninstall.ps1'",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-amd64.zip",
                "hash": {
                    "url": "https://github.com/t8y2/motty/releases/download/v$version/SHA256SUMS",
                    "find": "motty-$version-windows-amd64\\.zip"
                }
            },
            "arm64": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-arm64.zip",
                "hash": {
                    "url": "https://github.com/t8y2/motty/releases/download/v$version/SHA256SUMS",
                    "find": "motty-$version-windows-arm64\\.zip"
                }
            }
        }
    }
}
