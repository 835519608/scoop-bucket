{
    "version": "0.2.9",
    "description": "原生 SSH 工作台：终端、SFTP、端口转发、VNC/RDP 与 AI 助手同窗（Go + Viva，无 WebView）",
    "homepage": "https://github.com/t8y2/motty",
    "license": "Apache-2.0",
    "notes": [
        "Scoop 的 apps\\motty\\current 是目录联接；Motty 单实例规范化该路径会报 cannot determine on-disk case。",
        "用 env_set 设置 MOTTY_DATA_DIR=$persist_dir\\motty-data，绕开 current；数据仍由 persist 保留。",
        "此模式下密码库密钥走 Windows 凭据管理器（不再使用便携 vault.key）。",
        "安装/更新后若快捷方式仍失败，新开一个终端或注销一次，让 MOTTY_DATA_DIR 生效。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.2.9/motty-0.2.9-windows-amd64.zip",
            "hash": "01fd861eb08d86958b0ee91ec7594a57d68a7cf9c5a1cbdc1f6ac1389fa0215a"
        },
        "arm64": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.2.9/motty-0.2.9-windows-arm64.zip",
            "hash": "715a92ac45c7d07f456346aa15286a6d7c231bd1b1100fd46b665acbabc2e925"
        }
    },
    "pre_install": "New-Item -ItemType Directory -Force -Path \"$persist_dir\\motty-data\" | Out-Null",
    "bin": "motty.exe",
    "shortcuts": [
        [
            "motty.exe",
            "Motty"
        ]
    ],
    "persist": "motty-data",
    "env_set": {
        "MOTTY_DATA_DIR": "$persist_dir\\motty-data"
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-amd64.zip",
                "hash": {
                    "url": "https://github.com/t8y2/motty/releases/download/v$version/SHA256SUMS",
                    "find": "motty-$version-windows-amd64\\.zip"
                }
            },
            "arm64": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-arm64.zip",
                "hash": {
                    "url": "https://github.com/t8y2/motty/releases/download/v$version/SHA256SUMS",
                    "find": "motty-$version-windows-arm64\\.zip"
                }
            }
        }
    }
}
