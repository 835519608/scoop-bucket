{
    "version": "3.31.11",
    "description": "The AI Code Editor（Scoop portable，数据在 persist）",
    "homepage": "https://www.cursor.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.cursor.com/terms-of-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloads.cursor.com/production/52fdf018932f1335bc6dd36acc5e33d30759192e/win32/x64/user-setup/CursorUserSetup-x64-3.31.11.exe",
            "hash": "e24417f8f546968d1fe29c2fc1135f298e79e55da085cf1f04a95b769f5027c0"
        },
        "arm64": {
            "url": "https://downloads.cursor.com/production/52fdf018932f1335bc6dd36acc5e33d30759192e/win32/arm64/user-setup/CursorUserSetup-arm64-3.31.11.exe",
            "hash": "72d6fbbf710a231ad3a7b8a65f05646ce9fa8f297c8d64a7ef29168587eeb80e"
        }
    },
    "innosetup": true,
    "extract_dir": "{code_GetDestDir}",
    "bin": [
        [
            "resources\\app\\bin\\cursor.cmd",
            "cursor"
        ]
    ],
    "shortcuts": [
        [
            "Cursor.exe",
            "Cursor"
        ]
    ],
    "persist": "data",
    "notes": [
        "VS Code 系 portable：配置在 persist\\data（user-data / extensions），不走 %APPDATA%\\Cursor。",
        "若已装 extras/cursor：scoop uninstall cursor 后 scoop install scoop-bucket/cursor（同名 persist 会保留）。",
        "请先自行卸载官方安装（如 D:\\Program\\cursor），避免 target=system 继续写 C 盘。"
    ],
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/cursor/post_install.ps1'",
    "checkver": {
        "url": "https://www.cursor.com/api/download?platform=win32-x64-user&releaseTrack=stable",
        "regex": "production/(?<Code>[\\w]+)/win32.*-([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.cursor.com/production/$matchCode/win32/x64/user-setup/CursorUserSetup-x64-$version.exe"
            },
            "arm64": {
                "url": "https://downloads.cursor.com/production/$matchCode/win32/arm64/user-setup/CursorUserSetup-arm64-$version.exe"
            }
        }
    }
}
