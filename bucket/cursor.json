{
    "version": "3.31.15",
    "description": "The AI Code Editor（Scoop portable，数据在 persist）",
    "homepage": "https://www.cursor.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.cursor.com/terms-of-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloads.cursor.com/production/3eb8c13390837371c7c2f2013dc57fdbc802c753/win32/x64/user-setup/CursorUserSetup-x64-3.31.15.exe",
            "hash": "541387283c04d1dc89b9952fed6847f763cc206373646f46dbca6e12fa5f7ac1"
        },
        "arm64": {
            "url": "https://downloads.cursor.com/production/3eb8c13390837371c7c2f2013dc57fdbc802c753/win32/arm64/user-setup/CursorUserSetup-arm64-3.31.15.exe",
            "hash": "c56449406d6f1bda2a131dff616727631dc04048c8e1ccdc756b9f7a28aa3f45"
        }
    },
    "innosetup": true,
    "extract_dir": "{code_GetDestDir}",
    "bin": [
        [
            "resources\\app\\bin\\cursor.cmd",
            "cursor"
        ]
    ],
    "shortcuts": [
        [
            "Cursor.exe",
            "Cursor"
        ]
    ],
    "persist": "data",
    "notes": [
        "最新版（Excavator 会跟官方 stable）。需要 3.27.12：scoop install scoop-bucket/cursor327。",
        "portable：persist\\data；另联接 %APPDATA%\\Cursor、%USERPROFILE%\\.cursor → persist。",
        "与 cursor327 并存时，后安装/升级的一方会接管上述两条 C 盘联接。"
    ],
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/cursor/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/cursor/pre_uninstall.ps1'",
    "checkver": {
        "url": "https://www.cursor.com/api/download?platform=win32-x64-user&releaseTrack=stable",
        "regex": "production/(?<Code>[\\w]+)/win32.*-([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.cursor.com/production/$matchCode/win32/x64/user-setup/CursorUserSetup-x64-$version.exe"
            },
            "arm64": {
                "url": "https://downloads.cursor.com/production/$matchCode/win32/arm64/user-setup/CursorUserSetup-arm64-$version.exe"
            }
        }
    }
}
