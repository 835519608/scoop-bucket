    },
    "url": "https://a56.gdl.netease.com/UURemote_Setup_4.41.1.2335_0917134939_gwqd.exe?key1=9f557a67aa2b34f0932c3b885223f5da&key2=6ab10ed5&n=uuyc_4.41.1.exe",
    "hash": "4de4af35656d8395e01be64d094c5f750b2fd7c8b47db4289bce7b05cf85412e",
    "installer": {
        "script": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/uuyc/install.ps1'"
    },
    "pre_uninstall": "if (Get-Service -Name 'GameViewerService' -ErrorAction SilentlyContinue) { Stop-Service -Name 'GameViewerService' -Force -ErrorAction SilentlyContinue; sc.exe delete GameViewerService | Out-Null }",
    "uninstaller": {
        "script": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/uuyc/uninstall.ps1'"
    },
    "post_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/uuyc/post_uninstall.ps1'",
    "bin": "GameViewer\\GameViewer.exe",
    "shortcuts": [
        [
            "GameViewer\\GameViewer.exe",
            "UU远程"
        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd'",
            "$request = [System.Net.HttpWebRequest]::Create($url)",
            "$request.AllowAutoRedirect = $false",
            "$response = $request.GetResponse()",
            "$location = $response.Headers['Location']",
            "$response.Close()",
            "return $location"
        ],
        "regex": "(?<url>https://a56\\.gdl\\.netease\\.com/UURemote_Setup_(?<version>[\\d.]+)_[^?]+\\.exe\\?.*)"
    },
    "autoupdate": {
        "url": "$matchUrl",
        "hash": {
            "mode": "download"
        }
    },
    "notes": [
        "运行时：%LOCALAPPDATA%\\GameViewer → persist/AppData；%PROGRAMDATA%\\Netease\\GameViewer → persist/ProgramData（目录联接）。",
        "安装与卸载清理需管理员 PowerShell。"
    ]
}
