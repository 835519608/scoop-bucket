{
    "version": "4.12.4.43368774",
    "description": "腾讯云代码助手 CodeBuddy IDE 国内版（含 MCP；微信/手机号登录，codebuddy.cn）",
    "homepage": "https://www.codebuddy.cn/ide/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.codebuddy.cn/docs/ide/Getting-Started/Installation"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.codebuddy.cn/aiide/win32-x64-user/CodeBuddy-win32-x64-user-4.12.4.43368774-62ef1801-cn.exe",
            "hash": "849dc688336da8d79f12faef59fedc12a29935ecd922bdadb53e7591b4c9e3c9"
        }
    },
    "innosetup": true,
    "extract_dir": "{code_GetDestDir}",
    "bin": [
        [
            "bin\\buddycn.cmd",
            "buddycn"
        ],
        [
            "bin\\buddycn.cmd",
            "codebuddy-cn"
        ]
    ],
    "shortcuts": [
        [
            "CodeBuddy CN.exe",
            "CodeBuddy CN"
        ]
    ],
    "persist": "data",
    "notes": [
        "国内版 IDE（MCP / Agent 等在此；WorkBuddy 是办公 Agent，能力不同）。登录走 codebuddy.cn（微信/手机号）。",
        "使用 Scoop portable：配置在 persist\\data（对应默认的 %APPDATA%\\CodeBuddy CN 与 %USERPROFILE%\\.codebuddycn）。",
        "勿与国际版 codebuddy.ai 安装包混用。"
    ],
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/codebuddy-cn/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/codebuddy-cn/pre_uninstall.ps1'",
    "checkver": {
        "url": "https://www.codebuddy.cn/v2/update?platform=ide-win32-x64-user",
        "regex": "CodeBuddy-win32-x64-user-(?<version>\\d+(?:\\.\\d+)+)-(?<sha>[0-9a-f]+)-cn\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.codebuddy.cn/aiide/win32-x64-user/CodeBuddy-win32-x64-user-$version-$matchSha-cn.exe",
                "hash": {
                    "url": "https://www.codebuddy.cn/v2/update?platform=ide-win32-x64-user",
                    "jsonpath": "$.sha256hash"
                }
            }
        }
    }
}
