    "architecture": {
        "64bit": {
            "url": "https://github.com/t8y2/dbx/releases/download/v0.6.42/DBX_0.6.42_x64-setup.exe",
            "hash": "64f46ae51789a223eace4856d031abfda6a065e9267f5529b795ee579a09044a"
        }
    },
    "bin": "dbx.exe",
    "shortcuts": [
        [
            "dbx.exe",
            "dbx"
        ]
    ],
    "innosetup": false,
    "installer": {
        "args": [
            "/S",
            "/NS",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": "/S"
    },
    "notes": "NSIS 使用 /S /NS 不创建快捷方式，开始菜单项由 Scoop shortcuts 写入 Scoop Apps。%AppData%\\com.dbx.app、%LocalAppData%\\com.dbx.app、%USERPROFILE%\\.dbx 联接到 persist。",
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/dbx/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/dbx/pre_uninstall.ps1'",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t8y2/dbx/releases/download/v$version/DBX_$version_x64-setup.exe",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
