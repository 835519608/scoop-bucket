{
    "version": "0.5.17",
    "description": "Open-source database management tool",
    "homepage": "https://github.com/t8y2/dbx",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/t8y2/dbx/releases/download/v0.5.17/DBX_0.5.17_x64-setup.exe",
            "hash": "c8c2ff23608c06122d1e16b3e9fdbe030dfe5f5fa69ecd84e22761db579d04fe"
        }
    },
    "bin": "dbx.exe",
    "innosetup": false,
    "installer": {
        "args": ["/S", "/D=$dir"]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": ["/S"]
    },
    "notes": "Tauri NSIS 静默安装会建开始菜单快捷方式；post_install 仅删桌面 .lnk。%AppData%\\com.dbx.app、%LocalAppData%\\com.dbx.app、%USERPROFILE%\\.dbx 目录联接到 persist。",
    "post_install": [
        ". (Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\import-utils.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName",
        "Clear-DesktopShortcuts -Filter '*DBX*.lnk'",
        "$dbxMappings = @(",
        "    @{ Label = 'roaming'; Source = 'AppData/com.dbx.app'; Target = '$persist_dir/roaming'; EnsureTarget = $true }",
        "    @{ Label = 'local'; Source = 'LocalAppData/com.dbx.app'; Target = '$persist_dir/local'; EnsureTarget = $true }",
        "    @{ Label = 'profile'; Source = 'UserProfile/.dbx'; Target = '$persist_dir/.dbx'; EnsureTarget = $true }",
        ")",
        "Install-PersistDataLinks -Mappings $dbxMappings"
    ],
    "pre_uninstall": [
        ". (Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\import-utils.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName",
        "$dbxMappings = @(",
        "    @{ Label = 'roaming'; Source = 'AppData/com.dbx.app'; Target = '$persist_dir/roaming' }",
        "    @{ Label = 'local'; Source = 'LocalAppData/com.dbx.app'; Target = '$persist_dir/local' }",
        "    @{ Label = 'profile'; Source = 'UserProfile/.dbx'; Target = '$persist_dir/.dbx' }",
        ")",
        "Uninstall-PersistDataLinks -Mappings $dbxMappings"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t8y2/dbx/releases/download/v$version/DBX_$version_x64-setup.exe",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
