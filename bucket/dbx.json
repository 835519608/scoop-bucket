{
    "version": "0.5.17",
    "description": "Open-source database management tool",
    "homepage": "https://github.com/t8y2/dbx",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/t8y2/dbx/releases/download/v0.5.17/DBX_0.5.17_x64-setup.exe",
            "hash": "c8c2ff23608c06122d1e16b3e9fdbe030dfe5f5fa69ecd84e22761db579d04fe"
        }
    },
    "bin": "dbx.exe",
    "innosetup": false,
    "installer": {
        "args": ["/S", "/D=$dir"]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": ["/S"]
    },
    "notes": "经 Scoop shim 启动时须用 DBX_DATA_DIR（见 data_dir.rs）；dbx.db、plugins 均在 persist/data，不经过 %AppData%\\com.dbx.app。",
    "env_set": {
        "DBX_DATA_DIR": "$persist_dir\\data"
    },
    "post_install": [
        "if (-not (Test-Path \"$dir\\portable.dbx\")) { New-Item -ItemType File -Path \"$dir\\portable.dbx\" -Force | Out-Null }"
    ],
    "persist": [
        "data"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t8y2/dbx/releases/download/v$version/DBX_$version_x64-setup.exe",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
