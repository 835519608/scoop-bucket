    "homepage": "https://www.metatrader4.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.metatrader4.com/"
    },
    "url": "https://github.com/835519608/scoop-bucket/releases/download/metatrader-portable-2026.11.26/metatrader4-4.0.0.1492-portable.7z",
    "hash": "b7f5195573cc4cf0d327192383128f167cdbe53057d081c75078cf3cc5b08da2",
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\\\*\\\\bin\\\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/metatrader4/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\\\*\\\\bin\\\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/metatrader4/pre_uninstall.ps1'",
    "bin": [
        [
            "terminal.exe",
            "metatrader4",
            "/portable"
        ]
    ],
    "shortcuts": [
        [
            "terminal.exe",
            "MetaTrader 4",
            "/portable"
        ]
    ],
    "persist": [
        "config",
        "history",
        "logs",
        "MQL4",
        "profiles",
        "templates",
        "tester"
    ],
    "notes": [
        "启动：WinShun 输入 mt4，或 Scoop Apps\\MetaTrader 4.lnk（均带 /portable）。勿直接开 terminal.exe。",
        "多账号：& \"$env:SCOOP\\buckets\\scoop-bucket\\bin\\mt-clone.ps1\" -App metatrader4 -Name <实例名>（-SyncBinaries 同步程序）。"
    ]
}
