    "checkver": {
        "script": [
            "$key = 'win-downloader'",
            "$uuid = '0CE12A2C-3208-DBF7-7577-5C1C0E09A680'",
            "$ttl = 999999",
            "$castJson = Invoke-RestMethod 'https://dtapp-cast.dingtalk.com/dingtalk-desktop/win_x64/vista_later_v2.json'",
            "$castUrl = $castJson.win.install.url_v2",
            "$buildVer = [regex]::Match($castUrl, 'DingTalk_v([\\d.]+)\\.exe').Groups[1].Value",
            "$curVer = $expected_ver",
            "$curBuild = $curVer -replace '\\.\\d{12}$', ''",
            "$curTs = if ($curVer -match '(\\d{12})$') { $matches[1] } else { '0' }",
            "$now = [DateTimeOffset]::UtcNow.ToString('yyyyMMddHHmm')",
            "if ($curBuild -ne $buildVer -or $now -gt $curTs) {",
            "    $ms = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()",
            "    $sigStr = \"${castUrl}_${key}_${uuid}_${ms}_${ttl}\"",
            "    $sha = [System.Security.Cryptography.SHA256]::Create()",
            "    $hash = $sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($sigStr))",
            "    $sig = -join ($hash | ForEach-Object { $_.ToString('x2') })",
            "    $h = @{",
            "        'User-Agent'   = 'Downloader/10.0 Dingtalk/' + $castJson.win.install.version",
            "        'Url'          = $castUrl",
            "        'Key'          = $key",
            "        'TTL'          = $ttl.ToString()",
            "        'Timestamp'    = $ms.ToString()",
            "        'Signature'    = $sig",
            "        'Content-Type' = 'application/x-www-form-urlencoded'",
            "    }",
            "    $resp = Invoke-RestMethod -Uri 'https://dtupgrade.dingtalk.com/c/u/sign' -Method Post -Headers $h -Body '' -ErrorAction Stop",
            "    $signTs = [regex]::Match($resp.signedUrl, '/(\\d{12})/').Groups[1].Value",
            "    $newVer = \"${buildVer}.${signTs}\"",
            "    \"${newVer}=====$($resp.signedUrl)\"",
            "} else {",
            "    $curUrl = $json.url -replace '#/dl\\.7z$', ''",
            "    \"${curVer}=====$curUrl\"",
            "}"
        ],
        "regex": "(.*)=====(?<url>.*)"
    },
    "autoupdate": {
        "url": "$matchUrl#/dl.7z",
        "hash": {
            "url": "https://dtapp-cast.dingtalk.com/dingtalk-desktop/win_x64/vista_later_v2.json",
            "jsonpath": "$.win.install.md5"
        }
    }
