{
    "version": "0.3.1",
    "description": "跨平台软链接管理（CLI + GUI）",
    "homepage": "https://github.com/835519608/symm",
    "license": "MIT",
    "notes": [
        "根目录 symm.exe 为 GUI；CLI 为 cli/symm-cli.exe（命令 symm-cli）。",
        "数据目录：persist/data（symm.db、settings.json），SYMM_HOME=$dir\\data。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/835519608/symm/releases/download/v0.3.1/symm-portable-windows-x64.zip",
            "hash": "2ea1bfe609d94a4507be91428af9d435ecf20087d9cd35610dfe3f617171b478",
            "extract_dir": "symm"
        }
    },
    "bin": [
        [
            "symm.exe",
            "symm"
        ],
        [
            "cli/symm-cli.exe",
            "symm-cli"
        ]
    ],
    "shortcuts": [
        [
            "symm.exe",
            "symm"
        ]
    ],
    "persist": "data",
    "env_set": {
        "SYMM_HOME": "$dir\\data"
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/835519608/symm/releases/download/v$version/symm-portable-windows-x64.zip",
                "hash": {
                    "url": "https://github.com/835519608/symm/releases/download/v$version/SHA256SUMS",
                    "find": "symm-portable-windows-x64.zip"
                }
            }
        }
    }
}
