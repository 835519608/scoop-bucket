    "homepage": "https://github.com/varandrew/moor",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/varandrew/moor/releases/download/v0.9.0/Moor_0.9.0_x64-setup.exe",
            "hash": "868b3dfa3eaeb618ea6f3e588ce9fb7c24e3eb322fb49d6685c016ec86d75f23"
        }
    },
    "bin": [
        [
            "Moor.exe",
            "moor"
        ]
    ],
    "shortcuts": [
        [
            "Moor.exe",
            "Moor"
        ]
    ],
    "innosetup": false,
    "installer": {
        "args": [
            "/S",
            "/NS",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": "/S"
    },
    "notes": "NSIS 使用 /S /NS 静默安装且不创建开始菜单/桌面快捷方式，由 Scoop shortcuts 写入 Scoop Apps。数据目录见 %AppData%\\com.snowautumn.moor。",
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/moor/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/moor/pre_uninstall.ps1'",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/varandrew/moor/releases/download/v$version/Moor_$version_x64-setup.exe",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
