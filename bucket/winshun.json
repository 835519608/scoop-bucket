{
    "version": "0.48.0",
    "description": "Win顺 (WinShun)：文件 / 文件夹 / 内容搜索",
    "homepage": "https://github.com/LingCore/WinShun",
    "license": "MIT",
    "url": "https://github.com/LingCore/WinShun/releases/download/v0.48.0/WinShun-0.48.0-x64-portable.zip",
    "hash": "15951b539fb4d6e3f2a7526d67b3a78948119866d13f38ba5893ec449747d4e3",
    "extract_dir": "WinShun",
    "bin": "bin\\ws.exe",
    "shortcuts": [
        [
            "WinShun.exe",
            "WinShun"
        ]
    ],
    "persist": "data",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/winshun/pre_uninstall.ps1'",
    "notes": [
        "便携包（同官方 Scoop）：设置/索引在 persist\\winshun\\data（exe 旁 data 联接）。",
        "不要再联 %LOCALAPPDATA%\\WinShun；那是安装版路径，联上会干扰便携/Scoop 更新。",
        "全盘索引服务不随 Scoop 安装；可在 设置 > 搜索范围 > 磁盘 > 索引方式 中开启（服务会装到 Program Files\\WinShun Service，属正常）。"
    ],
    "checkver": {
        "github": "https://github.com/LingCore/WinShun"
    },
    "autoupdate": {
        "url": "https://github.com/LingCore/WinShun/releases/download/v$version/WinShun-$version-x64-portable.zip",
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
