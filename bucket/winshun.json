{
    "version": "0.45.0",
    "description": "Win顺 (WinShun)：文件 / 文件夹 / 内容搜索",
    "homepage": "https://github.com/LingCore/WinShun",
    "license": "MIT",
    "url": "https://github.com/LingCore/WinShun/releases/download/v0.45.0/WinShun-0.45.0-x64-portable.zip",
    "hash": "4fef2c78d9738a6f52aaaefce4a75abc49c27223ac9a14ed686556ede967f4ce",
    "extract_dir": "WinShun",
    "bin": "bin\\ws.exe",
    "shortcuts": [
        [
            "WinShun.exe",
            "WinShun"
        ]
    ],
    "persist": "data",
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/winshun/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/winshun/pre_uninstall.ps1'",
    "notes": [
        "便携包：data 由 Scoop persist。",
        "%LOCALAPPDATA%\\WinShun → persist/LocalAppData（缓存等）。",
        "全盘索引服务不随 Scoop 安装；可在 设置 > 搜索范围 > 磁盘 > 索引方式 中开启（需管理员）。"
    ],
    "checkver": {
        "github": "https://github.com/LingCore/WinShun"
    },
    "autoupdate": {
        "url": "https://github.com/LingCore/WinShun/releases/download/v$version/WinShun-$version-x64-portable.zip",
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
