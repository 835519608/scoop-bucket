    "installer": {
        "script": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/uu/install.ps1'"
    },
    "uninstaller": {
        "script": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/uu/uninstall.ps1'"
    },
    "bin": [
        [
            "uu_launcher.exe",
            "uu"
        ]
    ],
    "shortcuts": [
        [
            "uu_launcher.exe",
            "UU加速器"
        ]
    ],
    "notes": [
        "静默安装：/silent /install_path /install_createshortcut 0 /install_autorun 0 /no_launch_uu（含 TAP/WFP 驱动，需管理员 PowerShell）。",
        "安装时不写厂商快捷方式；开始菜单项由 Scoop shortcuts 写入 Scoop Apps。",
        "用户数据联接：%APPDATA%\\Netease\\UU、%LOCALAPPDATA%\\Netease\\UU、%PROGRAMDATA%\\Netease\\UU → persist。",
        "下载 URL 带签名参数，Excavator 会从 adl 页面刷新；#/UU-x.y.z.exe 避免查询串导致 Scoop 缓存路径非法。",
        "manifest 为 nightly（无 hash）；官网 CDN 可能同址换包，与 dorado todesk / steam 同策略。"
    ]
}
