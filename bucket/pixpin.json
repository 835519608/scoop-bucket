{
    "version": "3.3.5.7",
    "description": "强大且免费的截图、贴图、长截图、OCR 工具",
    "homepage": "https://pixpin.cn/",
    "license": "Unknown",
    "url": "https://down.pixpin.cn/PixPin_win_3.3.5.7.zip",
    "hash": "22eedc554a2e4cd1b1e1cdfc350189c797b2b1322d48066051c87c47848eb31b",
    "extract_dir": "PixPin",
    "bin": [
        [
            "PixPin.exe",
            "pixpin"
        ]
    ],
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "notes": "便携 zip 在程序目录写入 Config / Data / History（官网便携版行为）。",
    "persist": [
        "Config",
        "Data",
        "History"
    ],
    "checkver": {
        "script": [
            "$last = $null",
            "foreach ($i in 1..3) {",
            "    $out = & curl.exe -fsSL --max-time 25 --retry 2 --retry-delay 3 'https://pixpin.cn/download' 2>&1",
            "    if ($LASTEXITCODE -eq 0 -and $out) { return ($out | Out-String) }",
            "    $last = \"curl exit $LASTEXITCODE: $out\"",
            "    Start-Sleep -Seconds 5",
            "}",
            "throw $last"
        ],
        "regex": "PixPin_win_(?<version>\\d+(?:\\.\\d+)+)\\.zip"
    },
    "autoupdate": {
        "url": "https://down.pixpin.cn/PixPin_win_$version.zip",
        "hash": {
            "mode": "download"
        }
    }
}
