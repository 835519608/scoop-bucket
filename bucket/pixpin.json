{
    "version": "nightly",
    "description": "强大且免费的截图、贴图、长截图、OCR 工具",
    "homepage": "https://pixpin.cn/",
    "license": "Unknown",
    "url": "https://down.pixpin.cn/PixPin_win_3.6.6.0.zip",
    "extract_dir": "PixPin",
    "bin": [
        [
            "PixPin.exe",
            "pixpin"
        ]
    ],
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "notes": [
        "便携 zip：Config / Data / History 由 Scoop persist。",
        "另联接 %LOCALAPPDATA%\\PixPin → persist/LocalAppData（右键菜单等）。",
        "manifest 为 nightly（无 hash）；官网 CDN 可能同址换包，与 dorado todesk / steam 同策略。"
    ],
    "persist": [
        "Config",
        "Data",
        "History"
    ],
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/pixpin/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/pixpin/pre_uninstall.ps1'"
}
