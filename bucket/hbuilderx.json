{
    "version": "nightly",
    "description": "DCloud 出品的 HTML5 / uni-app / 多端开发 IDE（Windows 正式版 zip）",
    "homepage": "https://www.dcloud.io/hbuilderx.html",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.dcloud.io/hbuilderx.html"
    },
    "url": "https://download1.dcloud.net.cn/download/HBuilderX.5.34.2026102909.zip",
    "extract_dir": "HBuilderX",
    "bin": [
        [
            "HBuilderX.exe",
            "hbuilderx"
        ],
        [
            "cli.exe",
            "hbuilderx-cli"
        ]
    ],
    "shortcuts": [
        [
            "HBuilderX.exe",
            "HBuilderX"
        ]
    ],
    "persist": "plugins",
    "notes": [
        "目录联接：%APPDATA%\\HBuilder X、%LOCALAPPDATA%\\HBuilder X → persist/roaming、persist/local。",
        "插件目录 plugins 由 Scoop persist；已去掉自带 Updater.exe，请用 scoop update。",
        "manifest 为 nightly（无 hash）；官网 CDN 可能同址换包，与 dorado todesk / steam 同策略。"
    ],
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/hbuilderx/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\*\\bin\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/hbuilderx/pre_uninstall.ps1'"
}
