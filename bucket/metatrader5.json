    "hash": "83b2318fdd3c4526291a29ce4853beb4c7d71b34e239fd74fab8b5244d0d535d",
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\\\*\\\\bin\\\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/metatrader5/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\\\*\\\\bin\\\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/metatrader5/pre_uninstall.ps1'",
    "bin": [
        [
            "terminal64.exe",
            "metatrader5",
            "/portable"
        ]
    ],
    "shortcuts": [
        [
            "terminal64.exe",
            "MetaTrader 5",
            "/portable"
        ]
    ],
    "persist": [
        "Bases",
        "Config",
        "logs",
        "MQL5",
        "Profiles",
        "Tester"
    ],
    "notes": [
        "启动：WinShun 输入 mt5，或 Scoop Apps\\MetaTrader 5.lnk（均带 /portable）。勿直接开 terminal64.exe。",
        "多账号：& \"$env:SCOOP\\buckets\\scoop-bucket\\bin\\mt-clone.ps1\" -App metatrader5 -Name <实例名>（-SyncBinaries 同步程序）。"
    ]
}
