    "homepage": "https://www.metatrader5.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.metatrader5.com/en/terminal/terms"
    },
    "url": "https://github.com/835519608/scoop-bucket/releases/download/metatrader-portable-2026.11.26/metatrader5-5.0.0.6274-portable.7z",
    "hash": "83b2318fdd3c4526291a29ce4853beb4c7d71b34e239fd74fab8b5244d0d535d",
    "post_install": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\\\*\\\\bin\\\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/metatrader5/post_install.ps1'",
    "pre_uninstall": "& ((Get-ChildItem (Join-Path $scoopdir 'buckets\\\\*\\\\bin\\\\hook.ps1') -ErrorAction SilentlyContinue | Select-Object -First 1).FullName) 'hooks/metatrader5/pre_uninstall.ps1'",
    "bin": [
        [
            "terminal64.exe",
            "metatrader5",
            "/portable"
        ]
    ],
    "shortcuts": [
        [
            "terminal64.exe",
            "MetaTrader 5",
            "/portable"
        ]
    ],
    "persist": [
        "Bases",
        "Config",
        "logs",
        "MQL5",
        "Profiles",
        "Tester"
    ],
    "notes": [
        "从本仓库 GitHub Release 下载纯程序 7z（无账号/图表数据）；换电脑可直接 scoop install。",
        "WinShun：收藏命令关键词 mt5（带 /portable + 图标）。不要直接开搜到的 terminal64.exe。",
        "也可从 Scoop Apps 的 MetaTrader 5.lnk 启动。安装时会清 ProgramData 重复菜单并删 uninstall.exe。",
        "若本机仍有 D:\\Program\\MetaTrader\\MetaTrader 5，post_install 会可选迁入数据。",
        "多账号：& \"$env:SCOOP\\buckets\\scoop-bucket\\bin\\mt-clone.ps1\" -App metatrader5 -Name <实例名>",
        "同步程序：同上 -SyncBinaries。卸载模板不删除 persist\\metatrader5-instances。"
    ]
}
